{
  "name": "@whitepoint/manage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/dev.mjs manage",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler pages deploy dist --project-name=whitepoint-manage --branch main"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.0.0",
    "@whitepoint/types": "workspace:*",
    "@whitepoint/ui": "workspace:*",
    "@whitepoint/utils": "workspace:*",
    "docx": "^9.9.0",
    "docxtemplater": "^3.71.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.0",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.0",
    "leaflet": "^1.9.0",
    "lucide-react": "^1.53.0",
    "papaparse": "^5.7.0",
    "pizzip": "^3.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.0",
    "react-router": "7.18.4",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/file-saver": "^2.0.0",
    "@types/leaflet": "^1.9.0",
    "@types/papaparse": "^5.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.0",
    "wrangler": "^4.149.0"
  }
}
