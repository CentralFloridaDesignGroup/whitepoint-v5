{
  "name": "@whitepoint/manage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/dev.mjs manage",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler pages deploy dist --project-name=whitepoint-manage --branch main"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@whitepoint/types": "workspace:*",
    "@whitepoint/ui": "workspace:*",
    "@whitepoint/utils": "workspace:*",
    "lucide-react": "^1.53.0",
    "mermaid": "12.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.0",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.0",
    "wrangler": "^4.149.0"
  }
}
