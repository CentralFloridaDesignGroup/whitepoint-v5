{
  "name": "@whitepoint/main",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5100",
    "build": "tsc -p tsconfig.json && vite build && node scripts/prerender.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler pages deploy dist --project-name=whitepoint-main --branch main"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@whitepoint/types": "workspace:*",
    "@whitepoint/ui": "workspace:*",
    "@whitepoint/utils": "workspace:*",
    "d3-geo": "^3.1.0",
    "lucide-react": "^1.53.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.0",
    "@types/node": "^26.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.0",
    "@types/topojson-specification": "^1.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.0",
    "wrangler": "^4.149.0"
  }
}